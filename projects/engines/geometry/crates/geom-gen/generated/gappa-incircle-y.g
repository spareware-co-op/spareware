# where K = C * (1 - R); so whenever the filter answers, its sign is the exact one.
# This is the case where m_y is the largest maximum; each other case has its own problem.

@rnd = float<ieee_64, ne>;

# The filter's operations, as the generated code computes them.
a_lift_1 = rnd(ad_x * ad_x);
a_lift_2 = rnd(ad_y * ad_y);
a_lift = rnd(a_lift_1 + a_lift_2);
b_lift_1 = rnd(bd_x * bd_x);
b_lift_2 = rnd(bd_y * bd_y);
