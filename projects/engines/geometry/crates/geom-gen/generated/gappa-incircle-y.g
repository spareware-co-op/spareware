# The error of a product as its operands' errors times the other operand.
a_lift * bc - e_a_lift * e_bc -> a_lift * (bc - e_bc) + (a_lift - e_a_lift) * e_bc;
b_lift * ca - e_b_lift * e_ca -> b_lift * (ca - e_ca) + (b_lift - e_b_lift) * e_ca;
