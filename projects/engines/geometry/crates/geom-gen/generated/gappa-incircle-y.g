ab_2 = rnd(ad_y * bd_x);
ab = rnd(ab_1 - ab_2);
det_1 = rnd(a_lift * bc);
det_2 = rnd(b_lift * ca);
det_3 = rnd(det_1 + det_2);
det_4 = rnd(c_lift * ab);
det = rnd(det_3 + det_4);

# The same operations, exactly.
e_a_lift_1 = ad_x * ad_x;
e_a_lift_2 = ad_y * ad_y;
e_a_lift = e_a_lift_1 + e_a_lift_2;
e_b_lift_1 = bd_x * bd_x;
e_b_lift_2 = bd_y * bd_y;
e_b_lift = e_b_lift_1 + e_b_lift_2;
e_c_lift_1 = cd_x * cd_x;
e_c_lift_2 = cd_y * cd_y;
e_c_lift = e_c_lift_1 + e_c_lift_2;
e_bc_1 = bd_x * cd_y;
e_bc_2 = bd_y * cd_x;
e_bc = e_bc_1 - e_bc_2;
e_ca_1 = cd_x * ad_y;
e_ca_2 = cd_y * ad_x;
e_ca = e_ca_1 - e_ca_2;
e_ab_1 = ad_x * bd_y;
e_ab_2 = ad_y * bd_x;
e_ab = e_ab_1 - e_ab_2;
e_det_1 = e_a_lift * e_bc;
e_det_2 = e_b_lift * e_ca;
e_det_3 = e_det_1 + e_det_2;
e_det_4 = e_c_lift * e_ab;
e_det = e_det_3 + e_det_4;

# The scale S, the scale as the filter computes it, the constant C and the bound.
S = m_x * m_y * m_y * m_y;
scale = rnd(rnd(m_x * m_y) * rnd(m_y * m_y));
C = 0x1.4000000000008p-47;
bound = rnd(C * scale);

