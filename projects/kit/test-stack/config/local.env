# Settings for local testing against scripts/stack-up.sh and examples/mock_oidc.rs.
# These are throwaway values for your own machine; a real server gets its own (deploy/stack.env.example).
export STACK_BIND=127.0.0.1:8080
export STACK_PUBLIC_URL=http://localhost:8080
export STACK_PD=${STACK_PD:-127.0.0.1:2379}
export STACK_FILES_URL=s3://spare-files
export STACK_BACKUP_URL=file://$HOME/test-stack/backups
export OIDC_ISSUER=http://localhost:9000
export OIDC_CLIENT_ID=local-test
export OIDC_CLIENT_SECRET=local-test
export AWS_ENDPOINT=http://127.0.0.1:9100
export AWS_ALLOW_HTTP=true
export AWS_ACCESS_KEY_ID=testkey
export AWS_SECRET_ACCESS_KEY=testsecret
export AWS_REGION=us-east-1
