 "LINT": [
  {
   "id": "scope-1a",
   "rule": "Out-of-scope effects for a district land use consent",
   "source": "RMA s104(1A), s92(2AA) (Planning Act 2026 Sch 12 Pt 2)",
   "level": "warn",
   "re": {
    "$re": "\\b(retail distribution|trade competition|demand for (?:the )?(?:project|proposal|development|activity)|viability of (?:the )?(?:project|proposal|development|activity|centre)|views? from private (?:property|properties|land))\\b",
    "$flags": "i"
   },
   "suggest": "Remove it: for consents lodged from 30 Oct 2026 these effects are out of scope (s104(1A)), and a further-information request about them is barred (s92(2AA)). Traffic effects stay in scope."
  },
  {
   "id": "scope-cl7",
   "rule": "Traffic safety placed under Sch 4 cl 7(1)(f)",
   "source": "RMA Sch 4 cl 6(1)(b), 7(1)(a)",
   "level": "warn",
   "re": {
    "$re": "\\b(?:cl(?:ause)?\\.?\\s*7\\s*\\(1\\)\\s*\\(f\\))",
    "$flags": "i"
   },
   "also": {
    "$re": "\\bsafety\\b",
    "$flags": "i"
   },
   "suggest": "Assess traffic safety under Sch 4 cl 6(1)(b) and cl 7(1)(a) (effects on people and the community), not cl 7(1)(f)."
  },
  {
   "id": "scope-95a9",
   "rule": "s95A(9) special circumstances",
   "source": "RMA s95A(9) (repealed from 30 Oct 2026); AUP E27.5, C1.13; s95B(10)",
   "level": "warn",
   "re": {
    "$re": "\\bs(?:ection)?\\s?95A\\s*\\(9\\)|\\bspecial circumstances\\b",
    "$flags": "i"
   },
   "suggest": "s95A(9) is repealed for applications lodged from 30 Oct 2026, so the AUP E27.5 / C1.13 cross-references to it have no target. s95B(10) (limited notification special circumstances) remains: cite that if it is what you mean."
  },
  {
   "id": "scope-1c",
   "rule": "Planning Act or NEA instrument cited in a transition consent",
   "source": "RMA s104(1C) (Planning Act 2026 Sch 12 Pt 2)",
   "re": [
    {
     "$re": "\\bNational Policy Direction\\b",
     "$flags": "i"
    },
    {
     "$re": "\\bNatural Environment Act\\b",
     "$flags": "i"
    },
    {
     "$re": "\\bNEA\\b",
     "$flags": ""
    },
    {
     "$re": "\\bPlanning Act 2026\\b[^.;]{0,40}\\b(?:national standards?|regional plans?|instruments?|directions?)\\b",
     "$flags": "i"
    },
    {
     "$re": "\\bnational standards?\\b[^.;]{0,30}\\bPlanning Act\\b",
     "$flags": "i"
    }
   ],
   "skip": [
    {
     "$re": "\\b(?:not|never|no|nor|without)\\b[^.;]{0,50}\\b(?:rel(?:y|ied|ies|iance|ying)|cit(?:e|ed|es|ing)|regard|consider(?:ed|ing)?|appl(?:y|ied|ies|ying)|give effect)\\b",
     "$flags": "i"
    },
    {
     "$re": "\\bs(?:ection)?\\s?104\\s*\\(1C\\)[^.;]{0,80}\\b(?:bars?|prevents?|prohibits?|precludes?|must not|cannot|may not|does not (?:allow|permit))\\b",
     "$flags": "i"
    },
    {
     "$re": "\\b(?:bars?|prevents?|prohibits?|precludes?|excludes?)\\b[^.;]{0,60}\\breliance\\b",
     "$flags": "i"
    }
   ],
   "suggest": "Remove the citation: a consent or NoR processed under the RMA transition regime must not rely on National Policy Direction or other Planning Act or NEA instruments (s104(1C)). Report and package exports stay blocked until it is removed, or until the author records why the sentence is correct (Override).",
   "warnText": "Set the lodgement date: if this is lodged on or after 30 Oct 2026, s104(1C) bars reliance on Planning Act or NEA instruments and this citation blocks the report exports."
  },
  {
   "id": "scope-e27-ita",
   "rule": "\"ITA required\" tied to E27.6.1",
   "source": "AUP E27.6.1, E27.9 (an ITA may be required)",
   "level": "warn",
   "re": {
    "$re": "\\b(?:an? )?(?:ITA|integrated transport assessment)\\s+(?:is\\s+)?(?:required|mandatory)\\b|\\brequires? an? (?:ITA|integrated transport assessment)\\b",
    "$flags": "i"
   },
   "also": {
    "$re": "E27\\.6\\.1",
    "$flags": ""
   },
   "suggest": "Say \"E27.6.1 may require an ITA\": exceeding a Table E27.6.1.1 threshold makes the activity restricted discretionary, and the assessment matters decide what information is needed."
  },
  {
   "id": "scope-rca",
   "rule": "Auckland Transport named as road controlling authority",
   "source": "LGACA 2009 s47 (from 7 May 2026)",
   "level": "warn",
   "re": [
    {
     "$re": "\\bAuckland Transport\\b[^.;]{0,30}?\\b(?:road controlling authority|RCA)\\b",
     "$flags": "i"
    },
    {
     "$re": "\\bAT\\b(?:\\s*\\))?[^.;]{0,20}?\\b(?:road controlling authority|RCA)\\b",
     "$flags": ""
    },
    {
     "$re": "\\broad controlling authority\\b[^.;]{0,6}(?:\\(|,|:|is|was)?\\s*(?:the\\s+)?(?:Auckland Transport\\b|AT\\b)",
     "$flags": ""
    }
   ],
   "suggest": "Since 7 May 2026 Auckland Council is the road controlling authority (LGACA s47), with local boards on local and collector roads; Auckland Transport continues as the transport CCO. Quote AUP text that names Auckland Transport as written."
  },
  {
   "id": "scope-mbcm",
   "rule": "\"MBCM-compliant\" BCR without the full procedure and a validated model",
   "source": "NZTA MBCM v1.7.5; D4",
   "level": "warn",
   "re": {
    "$re": "\\bMBCM[- ]?compliant\\b|\\bcompliant with (?:the )?MBCM\\b",
    "$flags": "i"
   },
   "suggest": "Call it an indicative BCR (equivalent to an Indicative Efficiency Rating). It is MBCM-compliant only when the full procedures are applied to a TMDG-validated, independently reviewed model."
  },
  {
   "id": "scope-tmdg",
   "rule": "TMDG statistics presented as fitness for purpose",
   "source": "NZTA TMDG 2019; D6",
   "level": "warn",
   "re": {
    "$re": "\\bTMDG\\b|\\bTransport Model Development Guidelines\\b",
    "$flags": "i"
   },
   "also": {
    "$re": "\\bfit[- ]for[- ]purpose\\b|\\bfitness for purpose\\b",
    "$flags": "i"
   },
   "suggest": "Report the TMDG statistics as evidence, not as a pass that proves fitness for purpose: that is the analyst's and peer reviewer's judgment (D6)."
  },
  {
   "id": "scope-rasf",
   "rule": "RASF described as mandatory for developers",
   "source": "AT Roads and Streets Framework v2 (not mandated for developers)",
   "level": "warn",
   "re": {
    "$re": "\\bRASF\\b|\\bRoads and Streets Framework\\b",
    "$flags": "i"
   },
   "also": {
    "$re": "\\b(?:mandatory|must comply|is required|requires developers?|obliged|binding)\\b",
    "$flags": "i"
   },
   "suggest": "Describe the RASF as advisory: it is not mandated for developers (RASF v2). Use it to explain the street's place and movement role."
  }
 ],
