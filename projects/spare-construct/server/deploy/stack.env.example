# Copy this somewhere outside the repository, fill it in, and hand it to deploy.sh.
# It holds a secret, so it never goes in the repository.

# The address people will type: your domain or DuckDNS name.
STACK_PUBLIC_URL=https://example.duckdns.org

# From your Google OAuth client.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Which Google accounts sign in as which test person. Anyone not listed is turned away.
STACK_PEOPLE=anna=first.person@gmail.com,dan=second.person@gmail.com
