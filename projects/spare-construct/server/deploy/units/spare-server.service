[Unit]
Description=The Spare Construct test server
After=spare-tikv.service spare-rustfs.service
Requires=spare-tikv.service spare-rustfs.service

[Service]
User=spare
EnvironmentFile=/etc/spare-stack/stack.env
Environment=RUST_LOG=warn
ExecStart=/opt/spare-stack/bin/spare-server serve
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
